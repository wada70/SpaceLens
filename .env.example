# ── Confluence Data Center ──────────────────────────────────────────────────
CONFLUENCE_URL=https://your-confluence.example.com

# Option A – Personal Access Token (recommended for Data Center 7.9+)
CONFLUENCE_PAT=your_personal_access_token

# Option B – Basic Auth (username + password or legacy API token)
# CONFLUENCE_USERNAME=your.email@example.com
# CONFLUENCE_API_TOKEN=your_password_or_token

# Limit search to specific spaces (comma-separated keys), or leave blank for all
# CONFLUENCE_SPACE_KEYS=["ENG","HR","INFRA"]

# ── LLM (Ollama) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_MAX_TOKENS=512

# ── Re-ranker ───────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
SEARCH_MAX_RESULTS=20

# ── App ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# CORS_ORIGINS=["https://your-confluence.example.com"]
