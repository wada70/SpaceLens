# ── Confluence Data Center ──────────────────────────────────────────────────
CONFLUENCE_URL=https://your-confluence.example.com
CONFLUENCE_USERNAME=your.email@example.com
CONFLUENCE_API_TOKEN=your_personal_access_token

# Limit search to specific spaces (comma-separated keys), or leave blank for all
# CONFLUENCE_SPACE_KEYS=["ENG","HR","INFRA"]

# ── LLM (Anthropic) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=512

# ── Re-ranker ───────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
SEARCH_MAX_RESULTS=20

# ── App ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# CORS_ORIGINS=["https://your-confluence.example.com"]
